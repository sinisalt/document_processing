# Settings for docker-compose.yml (README "With Docker Compose"). Copy this file to .env next to it; docker compose
# reads .env on its own, and .env is git-ignored, so keys never reach the repository. Every value is optional: an
# empty or missing one falls back to the local default in docker-compose.yml. For a developer machine only.

# --- LLM providers (docs/09 "With Docker Compose", "LLM keys") ---
# Without a key the stack still processes e-invoice XML, and the demo PDFs replay recorded answers.
# llm-setup applies these on every `docker compose up`; `docker compose logs llm-setup` names the configuration in use.
# Anthropic: becomes the key of the seeded platform configuration llm-platform-eu, which llm-setup enables (and
# disables again when the key is removed).
ANTHROPIC_API_KEY=
# OpenAI: llm-setup keeps one platform OpenAI configuration active, the one with this key and OPENAI_MODEL (an OpenAI
# model id) for every stage, creating it when needed; a changed key replaces the previous one. Both are needed. With an
# Anthropic key as well, the configuration changed last is the one in use.
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Local passwords (well-known defaults, change them before the first start) ---
# SQL Server sa password; SQL Server's complexity rules apply (8+ characters, three of upper, lower, digit, symbol).
# It also goes into a connection string, so avoid ';' and '$'. SQL Server keeps the password it was created with:
# after changing it, `docker compose down -v` (which deletes all data) or change it inside SQL Server as well.
# Default: DocProc-Local-Only-1
DOCPROC_SQL_PASSWORD=
# Keycloak admin console at http://localhost:8080/admin (applied on Keycloak's first start). Default: admin / admin
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# --- Stack ---
# Ingest the demo documents of fixtures/demo when the database is first seeded (true or false). Default: true
DOCPROC_DEMO_DOCUMENTS=
# Interface the published ports bind to. Default: 127.0.0.1 (this machine only); 0.0.0.0 exposes them to the network.
DOCPROC_BIND_ADDRESS=
