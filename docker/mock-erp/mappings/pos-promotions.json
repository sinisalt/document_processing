{
  "mappings": [
    {
      "name": "pos-promotions: accept a promotion (today's specials, docs/11 §13.10)",
      "priority": 5,
      "request": {
        "method": "POST",
        "urlPath": "/api/promotions",
        "headers": {
          "Content-Type": {
            "contains": "json"
          }
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"promotionId\":\"{{jsonPath request.body '$.promotionId'}}\",\"status\":\"scheduled\",\"replaced\":\"{{jsonPath request.body '$.replaces'}}\",\"idempotencyKey\":\"{{request.headers.[Idempotency-Key]}}\",\"receivedAt\":\"{{now}}\"}",
        "transformers": [
          "response-template"
        ]
      }
    },
    {
      "name": "pos-promotions: refuse a body that is not JSON",
      "priority": 6,
      "request": {
        "method": "POST",
        "urlPath": "/api/promotions"
      },
      "response": {
        "status": 415,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "error": "unsupported_media_type",
          "message": "Send the promotion as application/json."
        }
      }
    },
    {
      "name": "pos-promotions: 503 when the request asks for it (X-Mock-Erp-Fail: 503)",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/api/promotions",
        "headers": {
          "X-Mock-Erp-Fail": {
            "equalTo": "503"
          }
        }
      },
      "response": {
        "status": 503,
        "headers": {
          "Content-Type": "application/json",
          "Retry-After": "1"
        },
        "jsonBody": {
          "error": "unavailable",
          "message": "pos-promotions is down (forced by X-Mock-Erp-Fail)."
        }
      }
    },
    {
      "name": "pos-promotions: 503 once after POST /__control/pos-promotions/fail-next",
      "priority": 1,
      "scenarioName": "pos-promotions",
      "requiredScenarioState": "fail-next",
      "newScenarioState": "Started",
      "request": {
        "method": "POST",
        "urlPath": "/api/promotions"
      },
      "response": {
        "status": 503,
        "headers": {
          "Content-Type": "application/json",
          "Retry-After": "1"
        },
        "jsonBody": {
          "error": "unavailable",
          "message": "pos-promotions is down for this one call (fail-next)."
        }
      }
    },
    {
      "name": "pos-promotions: 503 on every call after POST /__control/pos-promotions/fail-always",
      "priority": 1,
      "scenarioName": "pos-promotions",
      "requiredScenarioState": "down",
      "request": {
        "method": "POST",
        "urlPath": "/api/promotions"
      },
      "response": {
        "status": 503,
        "headers": {
          "Content-Type": "application/json",
          "Retry-After": "1"
        },
        "jsonBody": {
          "error": "unavailable",
          "message": "pos-promotions is down until POST /__control/pos-promotions/reset."
        }
      }
    },
    {
      "name": "control: pos-promotions fails the next call",
      "scenarioName": "pos-promotions",
      "newScenarioState": "fail-next",
      "request": {
        "method": "POST",
        "urlPath": "/__control/pos-promotions/fail-next"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "endpoint": "pos-promotions",
          "state": "fail-next"
        }
      }
    },
    {
      "name": "control: pos-promotions fails every call",
      "scenarioName": "pos-promotions",
      "newScenarioState": "down",
      "request": {
        "method": "POST",
        "urlPath": "/__control/pos-promotions/fail-always"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "endpoint": "pos-promotions",
          "state": "down"
        }
      }
    },
    {
      "name": "control: pos-promotions answers normally again",
      "scenarioName": "pos-promotions",
      "newScenarioState": "Started",
      "request": {
        "method": "POST",
        "urlPath": "/__control/pos-promotions/reset"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "endpoint": "pos-promotions",
          "state": "Started"
        }
      }
    }
  ]
}
