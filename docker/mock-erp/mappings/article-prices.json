{
  "mappings": [
    {
      "name": "article-prices: accept an article price import",
      "priority": 5,
      "request": {
        "method": "POST",
        "urlPath": "/api/article-prices",
        "headers": {
          "Content-Type": {
            "contains": "json"
          }
        }
      },
      "response": {
        "status": 202,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"importId\":\"AP-IMP-{{randomValue length=8 type='NUMERIC'}}\",\"status\":\"queued\",\"idempotencyKey\":\"{{request.headers.[Idempotency-Key]}}\",\"receivedAt\":\"{{now}}\"}",
        "transformers": [
          "response-template"
        ]
      }
    },
    {
      "name": "article-prices: refuse a body that is not JSON",
      "priority": 6,
      "request": {
        "method": "POST",
        "urlPath": "/api/article-prices"
      },
      "response": {
        "status": 415,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "error": "unsupported_media_type",
          "message": "Send the price list as application/json."
        }
      }
    },
    {
      "name": "article-prices: update a price list (PUT /api/article-prices/{priceListId}, OnReapproval Update)",
      "priority": 5,
      "request": {
        "method": "PUT",
        "urlPathPattern": "/api/article-prices/[^/]+",
        "headers": {
          "Content-Type": {
            "contains": "json"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"importId\":\"AP-UPD-{{randomValue length=8 type='NUMERIC'}}\",\"status\":\"updated\",\"priceListId\":\"{{request.pathSegments.[2]}}\",\"idempotencyKey\":\"{{request.headers.[Idempotency-Key]}}\",\"receivedAt\":\"{{now}}\"}",
        "transformers": [
          "response-template"
        ]
      }
    },
