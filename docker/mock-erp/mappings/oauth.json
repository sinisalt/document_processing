{
  "mappings": [
    {
      "name": "oauth: client-credentials token for the delivery demos (any client)",
      "priority": 5,
      "request": {
        "method": "POST",
        "urlPath": "/oauth/token",
        "bodyPatterns": [
          { "contains": "grant_type=client_credentials" }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "access_token": "mock-erp-token",
          "token_type": "Bearer",
          "expires_in": 3600
        }
      }
    },
    {
      "name": "oauth: refuse any other grant",
      "priority": 6,
      "request": {
        "method": "POST",
        "urlPath": "/oauth/token"
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "error": "unsupported_grant_type"
        }
      }
    }
  ]
}
