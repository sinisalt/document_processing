<Project>
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime / hosting -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />

    <!-- Data -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <!-- Transitive of Microsoft.Data.SqlClient; pinned above a known-vulnerable version -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />

    <!-- LLM -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Anthropic" Version="13.3.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />

    <!-- Aspire (local orchestration) and telemetry -->
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.6.4-preview.1.26523.11" />
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.4" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.6" />

    <!-- Documents -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="PDFtoImage" Version="5.4.0" />
    <PackageVersion Include="PDFsharp" Version="6.5.0" />
    <!-- Same version PDFtoImage 5.4.0 depends on; referenced directly by DocProc.Llm for page thumbnails. -->
    <PackageVersion Include="SkiaSharp" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
    <PackageVersion Include="MimeKit" Version="4.18.2" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <!-- JSON Schema 2020-12 validation of definitions (docs/11 §5.2, §5.5, §11). Pinned to 8.x on purpose: 8.0.5 is
         the last release under the MIT licence; from 9.0 the binary releases ship under the json-everything "Open
         Source Maintenance Fee" EULA (a monthly fee for revenue-generating users above US$10k a year), see the
         licence note in docs/11 §5.5 before moving past 8.x. -->
    <PackageVersion Include="JsonSchema.Net" Version="8.0.5" />
    <!-- JSONata for output mappings (docs/11 §13.1, MIT). It has no cancellation of a running evaluation, so it runs
         only inside the renderer child process (src/DocProc.Outputs.Renderer), which the hosts kill at the time and
         memory limits; see the P3 spike in docs/11 §13.1. -->
    <PackageVersion Include="Jsonata.Net.Native" Version="3.0.0" />

    <!-- Azure -->
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />

    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.16.0" />
    <!-- Same version Aspire.Hosting.Docker brings; DocProc.AppHost.Tests reads docker-compose.yml with it. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
