# `pnpm build`: OpenID Connect against the realm the AppHost provisions (src/DocProc.AppHost/realms/docproc-realm.json).
# Override per deployment; the values are read at build time.
VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/docproc
VITE_OIDC_CLIENT_ID=docproc-admin
# VITE_API_BASE_URL=https://api.example.com   (empty: same origin)
