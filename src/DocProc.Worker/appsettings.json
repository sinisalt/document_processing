{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Pipeline": {
    "RunInProcess": true,
    "MaxParallelism": 2,
    "RetryBaseDelay": "00:00:05",
    "MaxAttempts": 5,
    "MaxRetryDelay": "00:10:00",
    "RenderDpi": 200,
    "LlmClassificationThreshold": 0.6,
    "MaxArchiveDepth": 2,
    "MaxArchiveEntryBytes": 67108864,
    "MaxArchiveEntries": 200,
    "MinimumImageBytes": 20480,
    "ShutdownGracePeriod": "00:00:30"
  },
  "DocumentProcessing": {
    "Pdf": {
      "TextLayerMinimumWordsPerPage": 5,
      "MaximumRenderDpi": 600,
      "MaximumPdfBytes": 104857600,
      "MaximumAttachmentBytes": 33554432
    },
    "Classifier": {
      "ConfidenceThreshold": 0.6,
      "FirstPageHeaderFactor": 2.0,
      "FirstPageFactor": 1.0,
      "LaterPageFactor": 0.4,
      "BodyTitleFactorWhenHeaderTaken": 0.5,
      "StrongEvidenceScore": 8.0
    },
    "Splitter": {
      "BlankPageMaxWords": 2,
      "StartThreshold": 2.0,
      "CertainScore": 3.0,
      "NoSignalCertainty": 0.6,
      "ConfidenceThreshold": 0.7,
      "MaxConfidentPageCount": 6,
      "HeaderBandFraction": 0.12,
      "HeaderSimilarityThreshold": 0.5
    }
  },
  "Llm": {
    "Secrets": {
      "llm-platform-eu": ""
    }
  }
}
