<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <Description>Pipeline worker host.</Description>
    <UserSecretsId>docproc-worker</UserSecretsId>
    <!-- Microsoft.Data.SqlClient refuses to open a connection in invariant globalization mode ("Globalization Invariant
         Mode is not supported"), so a process that talks to SQL Server needs ICU (Directory.Build.props sets invariant mode for the rest). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DocProc.Application/DocProc.Application.csproj" />
    <ProjectReference Include="../DocProc.Infrastructure/DocProc.Infrastructure.csproj" />
    <ProjectReference Include="../DocProc.Pipeline/DocProc.Pipeline.csproj" />
    <ProjectReference Include="../DocProc.ServiceDefaults/DocProc.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
