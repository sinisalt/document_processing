{
  "key": "std.invoice",
  "version": 1,
  "legacyKey": "Invoice",
  "name": {
    "en": "Invoice",
    "de": "Rechnung"
  },
  "description": "A supplier's bill for goods or services, with lines, VAT breakdown and totals.",
