{
  "Persistence": {
    "Provider": "Sqlite",
    "SqlitePath": "./data/docproc.db",
    "MigrateOnStartup": true
  },
  "ConnectionStrings": {
    "DocProc": "Server=localhost,1433;Database=DocProc;User Id=sa;Password=<set via user-secrets>;TrustServerCertificate=true"
  },
  "Authentication": {
    "Dev": {
      "Enabled": true,
      "SigningKeyPath": "./data/dev-signing-key.pem"
    },
    "Oidc": {
      "Authority": "http://localhost:8080/realms/docproc",
      "Audience": "docproc-api",
      "RequireHttpsMetadata": false
    }
  }
}
