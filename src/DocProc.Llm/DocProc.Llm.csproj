<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Provider-neutral LLM gateway: provider interface, request/response model, prompt bundles, portable JSON schema, LLM extraction path.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DocProc.Domain/DocProc.Domain.csproj" />
    <ProjectReference Include="../DocProc.Application/DocProc.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Page thumbnails for the split call (PageThumbnails); the same SkiaSharp PDFtoImage pulls into Infrastructure. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>
  <ItemGroup>
    <!-- Prompt catalogue (docs/06 "Request design"): one embedded resource per prompt part, loaded by PromptCatalogue. -->
    <EmbeddedResource Include="Prompts/*.md" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Prompts/*.json" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
