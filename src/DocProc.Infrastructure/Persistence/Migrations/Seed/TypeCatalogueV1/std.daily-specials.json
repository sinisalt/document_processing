{
  "key": "std.daily-specials",
  "version": 1,
  "base": {
    "template": "std.price-list",
    "version": 1,
    "mode": "copy"
  },
  "name": {
    "en": "Daily specials",
    "de": "Tagesangebote"
  },
  "description": "Special prices valid for a single day, usually a short list sent early in the morning.",
  "roles": {
    "documentNumber": "priceListNumber",
    "documentDate": "issueDate",
    "currency": "currency",
    "validFrom": "validFrom",
    "validUntil": "validUntil",
    "supplierParty": "supplier",
    "customerParty": "customer",
    "lineItems": "lines",
    "lineUnitPrice": "lines[*].price",
    "lineSku": "lines[*].supplierSku",
    "duplicateKey": [
      "$supplierId",
      "validFrom",
      "listScope",
      "priceListNumber"
    ]
  },
  "ui": {
    "sections": [
      {
        "id": "list",
        "label": {
          "en": "List",
          "de": "Liste"
        }
      },
      {
        "id": "supplier",
        "label": {
          "en": "Supplier",
          "de": "Lieferant"
        }
      },
      {
        "id": "lines",
        "label": {
          "en": "Articles",
          "de": "Artikel"
        }
      }
    ]
  },
  "fields": [
    {
      "id": "fld_pl_no",
      "key": "priceListNumber",
      "kind": "identifier",
      "section": "list",
      "indexed": true,
      "label": {
        "en": "Price list no.",
        "de": "Preislisten-Nr."
      },
      "extraction": {
        "labels": {
          "de": [
            "Preisliste Nr.",
            "Preislisten-Nr."
          ],
          "en": [
            "Price list no."
          ]
        }
      }
    },
    {
      "id": "fld_pl_title",
      "key": "title",
      "kind": "string",
      "section": "list",
      "label": {
        "en": "Title",
        "de": "Titel"
      }
    },
    {
      "id": "fld_pl_issue",
      "key": "issueDate",
      "kind": "date",
      "section": "list",
      "label": {
        "en": "Issue date",
        "de": "Ausstellungsdatum"
      }
    },
    {
      "id": "fld_pl_from",
      "key": "validFrom",
      "kind": "date",
      "required": true,
      "section": "list",
      "indexed": true,
      "label": {
        "en": "Valid from",
        "de": "Gültig ab"
      },
      "extraction": {
        "labels": {
          "de": [
            "gültig ab",
            "Gültig vom",
            "Preise ab"
          ],
          "en": [
            "valid from",
            "effective"
          ]
        }
      }
    },
    {
      "id": "fld_pl_until",
      "key": "validUntil",
      "kind": "date",
      "section": "list",
      "label": {
        "en": "Valid until",
        "de": "Gültig bis"
      },
      "description": "Empty means valid until replaced."
    },
    {
      "id": "fld_pl_scope",
      "key": "listScope",
      "kind": "enum",
      "section": "list",
      "indexed": true,
      "label": {
        "en": "Scope",
        "de": "Umfang"
      },
      "description": "Full replaces every price of the supplier; Changes updates only the listed articles.",
      "options": [
        {
          "code": "Full",
          "label": {
            "en": "Full list",
            "de": "Gesamtliste"
          }
        },
        {
          "code": "Changes",
          "label": {
            "en": "Changes",
            "de": "Änderungsliste"
          }
        }
      ]
    },
    {
      "id": "fld_pl_cur",
      "key": "currency",
      "kind": "currency",
      "required": true,
      "section": "list",
      "label": {
        "en": "Currency",
        "de": "Währung"
      }
    },
    {
      "id": "fld_pl_basis",
      "key": "priceBasis",
      "kind": "enum",
      "section": "list",
      "label": {
        "en": "Price basis",
        "de": "Preisbasis"
      },
      "options": [
        {
          "code": "Net",
          "label": {
            "en": "Net",
            "de": "netto"
          }
        },
        {
          "code": "Gross",
          "label": {
            "en": "Gross",
            "de": "brutto"
          }
        }
      ]
    },
    {
      "id": "fld_pl_count",
      "key": "declaredLineCount",
      "kind": "integer",
      "section": "list",
      "label": {
        "en": "Printed article count",
        "de": "Gedruckte Artikelanzahl"
      },
      "description": "Number of articles printed on the list, if any (for example 'Anzahl Artikel: 412'). Used as a control figure.",
      "extraction": {
        "labels": {
          "de": [
            "Anzahl Artikel",
            "Positionen"
          ],
          "en": [
            "Number of items"
          ]
        }
      }
    },
    {
      "id": "fld_sup",
      "key": "supplier",
      "kind": "party",
      "required": true,
      "section": "supplier",
      "label": {
        "en": "Supplier",
        "de": "Lieferant"
      }
    },
    {
      "id": "fld_cust",
      "key": "customer",
      "kind": "party",
      "section": "supplier",
      "label": {
        "en": "Customer",
        "de": "Kunde"
      }
    },
    {
      "id": "fld_c_scr",
      "key": "supplierCustomerRef",
      "kind": "identifier",
      "section": "supplier",
      "label": {
        "en": "Our customer no. at supplier",
        "de": "Unsere Kundennummer beim Lieferanten"
      }
    },
    {
      "id": "fld_lines",
      "key": "lines",
      "kind": "array",
      "anchor": "supplierSku",
      "section": "lines",
      "maxItems": 10000,
      "label": {
        "en": "Articles",
        "de": "Artikel"
      },
      "item": {
        "fields": [
          {
            "id": "fld_l_sku",
            "key": "supplierSku",
            "kind": "identifier",
            "required": true,
            "label": {
              "en": "Article no.",
              "de": "Art.-Nr."
            }
          },
          {
            "id": "fld_l_gtin",
            "key": "gtin",
            "kind": "identifier",
            "pattern": "^[0-9]{8}([0-9]{4,6})?$",
            "label": {
              "en": "GTIN",
              "de": "GTIN"
            }
          },
          {
            "id": "fld_l_desc",
            "key": "description",
            "kind": "text",
            "required": true,
            "label": {
              "en": "Description",
              "de": "Bezeichnung"
            }
          },
          {
            "id": "fld_l_cat",
            "key": "category",
            "kind": "string",
            "label": {
              "en": "Category",
              "de": "Warengruppe"
            },
            "description": "Group heading the row is printed under, for example 'Rotweine'."
          },
          {
            "id": "fld_l_unit",
            "key": "unit",
            "kind": "unit",
            "codeList": "uom",
            "label": {
              "en": "Order unit",
              "de": "Bestelleinheit"
            }
          },
          {
            "id": "fld_l_pack",
            "key": "packSize",
            "kind": "decimal",
            "min": 0,
            "label": {
              "en": "Pack size",
              "de": "Inhalt"
            },
            "description": "Number of content units per order unit, for example 6 bottles per case."
          },
          {
            "id": "fld_l_packu",
            "key": "packUnit",
            "kind": "unit",
            "codeList": "uom",
            "label": {
              "en": "Content unit",
              "de": "Inhaltseinheit"
            }
          },
          {
            "id": "fld_l_packd",
            "key": "packDescription",
            "kind": "string",
            "label": {
              "en": "Pack as printed",
              "de": "Gebinde (gedruckt)"
            },
            "description": "As printed, for example '6 x 0,75 l'."
          },
          {
            "id": "fld_l_pq",
            "key": "priceQuantity",
            "kind": "decimal",
            "min": 0,
            "label": {
              "en": "Price per quantity",
              "de": "Preiseinheit"
            },
            "description": "The price applies per this many units (for example 'per 100'). Empty means 1."
          },
          {
            "id": "fld_l_price",
            "key": "price",
            "kind": "money",
            "currencyFrom": "currency",
            "required": true,
            "label": {
              "en": "Price",
              "de": "Preis"
            }
          },
          {
            "id": "fld_l_prev",
            "key": "previousPrice",
            "kind": "money",
            "currencyFrom": "currency",
            "label": {
              "en": "Previous price",
              "de": "Alter Preis"
            },
            "description": "Printed old price, for example 'statt 12,99'."
          },
          {
            "id": "fld_l_tax",
            "key": "taxRate",
            "kind": "percent",
            "label": {
              "en": "VAT rate",
              "de": "MwSt.-Satz"
            }
          },
          {
            "id": "fld_l_moq",
            "key": "minOrderQuantity",
            "kind": "decimal",
            "min": 0,
            "label": {
              "en": "Minimum order quantity",
              "de": "Mindestbestellmenge"
            }
          },
          {
            "id": "fld_l_tiers",
            "key": "tiers",
            "kind": "array",
            "anchor": "minQuantity",
            "label": {
              "en": "Tier prices",
              "de": "Staffelpreise"
            },
            "item": {
              "fields": [
                {
                  "id": "fld_t_qty",
                  "key": "minQuantity",
                  "kind": "decimal",
                  "required": true,
                  "min": 0,
                  "label": {
                    "en": "From quantity",
                    "de": "Ab Menge"
                  }
                },
                {
                  "id": "fld_t_price",
                  "key": "price",
                  "kind": "money",
                  "currencyFrom": "currency",
                  "required": true,
                  "label": {
                    "en": "Price",
                    "de": "Preis"
                  }
                }
              ]
            }
          },
          {
            "id": "fld_l_from",
            "key": "lineValidFrom",
            "kind": "date",
            "label": {
              "en": "Row valid from",
              "de": "Zeile gültig ab"
            }
          },
          {
            "id": "fld_l_until",
            "key": "lineValidUntil",
            "kind": "date",
            "label": {
              "en": "Row valid until",
              "de": "Zeile gültig bis"
            }
          },
          {
            "id": "fld_l_status",
            "key": "status",
            "kind": "enum",
            "label": {
              "en": "Row status",
              "de": "Status"
            },
            "options": [
              {
                "code": "New",
                "label": {
                  "en": "New",
                  "de": "Neu"
                }
              },
              {
                "code": "Changed",
                "label": {
                  "en": "Changed",
                  "de": "Geändert"
                }
              },
              {
                "code": "Discontinued",
                "label": {
                  "en": "Discontinued",
                  "de": "Auslauf"
                }
              },
              {
                "code": "Unchanged",
                "label": {
                  "en": "Unchanged",
                  "de": "Unverändert"
                }
              }
            ]
          },
          {
            "id": "fld_l_ext",
            "key": "ext",
            "kind": "bag",
            "label": {
              "en": "Supplier-specific attributes",
              "de": "Lieferantenspezifische Angaben"
            }
          }
        ]
      }
    },
    {
      "id": "fld_ext",
      "key": "ext",
      "kind": "bag",
      "label": {
        "en": "Supplier-specific attributes",
        "de": "Lieferantenspezifische Angaben"
      }
    }
  ],
  "rules": [
    {
      "id": "r_validity",
      "kind": "dateOrder",
      "params": {
        "before": "validFrom",
        "after": "validUntil",
        "allowEqual": true
      },
      "severity": "blocking"
    },
    {
      "id": "r_not_expired",
      "kind": "datePlausibility",
      "params": {
        "path": "validUntil",
        "maxPastDays": 0,
        "relativeTo": "now"
      },
      "severity": "blocking",
      "message": {
        "en": "These specials have already expired",
        "de": "Angebot ist bereits abgelaufen"
      }
    },
    {
      "id": "r_price_pos",
      "kind": "range",
      "params": {
        "path": "lines[*].price.amount",
        "min": 0.0001
      },
      "severity": "blocking"
    },
    {
      "id": "r_pack",
      "kind": "range",
      "params": {
        "path": "lines[*].packSize",
        "min": 0.0001
      }
    },
    {
      "id": "r_unit",
      "kind": "lookupExists",
      "params": {
        "path": "lines[*].unit",
        "table": "uom"
      }
    },
    {
      "id": "r_dup",
      "kind": "duplicate",
      "params": {
        "onMatch": "revision"
      },
      "severity": "warning"
    }
  ],
  "processing": {
    "split": {
      "mode": "never"
    },
    "extract": [
      {
        "id": "map",
        "kind": "supplier-mapping"
      },
      {
        "id": "llm",
        "kind": "llm",
        "params": {
          "mode": "fill-missing",
          "effort": "low"
        }
      },
      {
        "id": "defaults",
        "kind": "defaults",
        "params": {
          "values": {
            "currency": {
              "fromSupplierSetting": "defaults.currency"
            },
            "validFrom": {
              "from": [
                "issueDate",
                "$source.receivedDate"
              ],
              "mode": "ifMissing"
            },
            "validUntil": {
              "from": "validFrom",
              "mode": "ifMissing"
            },
            "listScope": {
              "value": "Changes",
              "mode": "ifMissing"
            }
          }
        }
      },
      {
        "id": "uom",
        "kind": "code-list",
        "params": {
          "list": "uom"
        }
      }
    ],
    "validate": [
      {
        "id": "schema",
        "kind": "validate.schema"
      },
      {
        "id": "rules",
        "kind": "validate.rules"
      }
    ],
    "review": {
      "autoApprove": false
    }
  },
  "classification": {
    "description": "Special prices valid for a single day, usually a short list sent early in the morning.",
    "keywords": {
      "de": [
        "Tagesangebot",
        "Angebot des Tages",
        "Tagespreise",
        "heute"
      ],
      "en": [
        "Today's specials",
        "Daily offer"
      ]
    },
    "negatives": {
      "de": [
        "Preisliste 20"
      ]
    }
  },
  "llm": {
    "guidance": "Extract the header and every row. Copy prices exactly as printed; leave previousPrice empty unless an old price is printed.",
    "examples": "template"
  }
}
