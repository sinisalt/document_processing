      "credentials": [{ "type": "password", "value": "tenant-a-admin", "temporary": false }],
      "realmRoles": ["TenantAdmin"]
    },
    {
      "username": "tenant-a-reviewer",
      "enabled": true,
      "email": "reviewer@tenant-a.local",
