{
  "realm": "docproc",
  "enabled": true,
  "displayName": "DocProc (local development)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "SuperAdmin", "description": "Platform: everything" },
      { "name": "Operator", "description": "Platform: global review queue, retries, read any document" },
      { "name": "TenantAdmin", "description": "Tenant: members, suppliers, channels, policy, API keys, webhooks" },
      { "name": "Reviewer", "description": "Tenant: review, correct, approve" },
      { "name": "Viewer", "description": "Tenant: read documents and exports" }
    ]
  },
  "clientScopes": [
    {
      "name": "docproc",
      "description": "DocProc claims: realm roles and tenant id",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "docproc-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "docproc-api",
      "name": "DocProc API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "docproc-portal",
      "name": "Customer portal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:3000/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+" },
      "defaultClientScopes": ["openid", "profile", "email", "docproc"]
    },
    {
      "clientId": "docproc-admin",
      "name": "Admin console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5174/*", "http://localhost:3001/*"],
      "webOrigins": ["http://localhost:5174", "http://localhost:3001"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+" },
      "defaultClientScopes": ["openid", "profile", "email", "docproc"]
    }
  ],
  "users": [
    {
      "username": "superadmin",
      "enabled": true,
      "email": "superadmin@docproc.local",
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Super",
      "credentials": [{ "type": "password", "value": "superadmin", "temporary": false }],
      "realmRoles": ["SuperAdmin"]
    },
    {
      "username": "operator",
