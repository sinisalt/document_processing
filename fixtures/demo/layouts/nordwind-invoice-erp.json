{
  "layoutKey": "nordwind-invoice-erp",
  "name": "Nordwind invoice (ERP)",
  "documentTypeKey": "Invoice",
  "identification": {
    "all": [
      { "text": "Rechnung", "page": 1, "region": "title" },
      { "supplierValue": "vatId", "page": 1 }
    ],
    "none": [{ "text": "Gutschrift", "page": 1 }]
  },
  "mapping": {
    "locale": "de-DE",
    "fields": {
      "invoiceNumber": { "rules": [{ "strategy": "label-right", "labels": ["Rechnungs-Nr."], "page": 1 }] },
      "issueDate": { "rules": [{ "strategy": "label-right", "labels": ["Rechnungsdatum"], "page": 1 }] },
      "supplierCustomerRef": { "rules": [{ "strategy": "label-right", "labels": ["Kunden-Nr."], "page": 1 }] },
      "currency": { "rules": [{ "strategy": "regex-anywhere", "pattern": "\\d,\\d{2}\\s+(EUR)\\b", "group": 1 }] },
      "supplier.name": { "rules": [{ "strategy": "constant", "value": "Nordwind Großhandel GmbH" }] },
      "supplier.vatId": {
        "rules": [{ "strategy": "regex-anywhere", "pattern": "USt-IdNr\\.\\s*([A-Z]{2}[0-9 ]{9,13})", "group": 1, "page": 1 }],
        "transforms": [{ "op": "removeWhitespace" }]
      },
      "customer.name": { "rules": [{ "strategy": "region", "page": 1, "bBox": [62, 118, 420, 140], "tolerance": 4 }] },
      "subtotalNet": { "rules": [{ "strategy": "label-right", "labels": ["Summe netto"] }] },
      "totalTax": { "rules": [{ "strategy": "label-right", "labels": ["USt 19 %"] }] },
      "totalGross": { "rules": [{ "strategy": "label-right", "labels": ["Gesamtbetrag"] }] },
      "taxBreakdown.rate": { "rules": [{ "strategy": "constant", "value": "19" }] },
      "taxBreakdown.taxableAmount": { "rules": [{ "strategy": "label-right", "labels": ["Summe netto"] }] },
      "taxBreakdown.taxAmount": { "rules": [{ "strategy": "label-right", "labels": ["USt 19 %"] }] },
      "lines": {
        "strategy": "column-table",
        "page": "*",
        "bBox": [60, 265, 925, 940],
        "headerRow": { "y0": 265, "y1": 280 },
        "columns": [
          { "x0": 60, "x1": 104, "field": "lineNumber", "header": "Pos" },
          { "x0": 104, "x1": 205, "field": "supplierSku", "header": "Art.-Nr." },
          { "x0": 205, "x1": 544, "field": "description", "header": "Bezeichnung" },
          { "x0": 544, "x1": 615, "field": "quantity", "header": "Menge" },
          { "x0": 615, "x1": 690, "field": "unit", "header": "Einheit" },
          { "x0": 690, "x1": 800, "field": "unitPrice", "header": "Einzelpreis" },
          { "x0": 800, "x1": 926, "field": "lineNet", "header": "Betrag" }
        ],
        "rowAnchor": "supplierSku",
        "stopAt": ["^Summe netto"]
      }
    },
    "requiredFields": ["invoiceNumber", "totalGross"]
  }
}
